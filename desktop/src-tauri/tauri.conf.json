{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telegram Media Downloader",
  "version": "0.2.2",
  "identifier": "app.telegram-media-downloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Telegram Media Downloader",
        "width": 1320,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost ws://127.0.0.1:1421; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese", "English"] }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/0verL1nk/telegram_media_downloader/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNjg5NDJBNEQyNTFEMzEKUldReEhTVk5LcFJvZnBvMWluaG5CMEJjMmowKzJZTnV2ZmltZ3JxRFRYeXNnS3FjSFYxOVRSOCsK"
    }
  }
}
