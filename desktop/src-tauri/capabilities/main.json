{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local-ui",
  "description": "Capabilities for the trusted local React interface",
  "webviews": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "allow-main-commands",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
